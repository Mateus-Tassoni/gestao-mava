# Copie para .env na máquina onde for rodar:  copy env.example .env  (Windows) ou cp env.example .env
# Preencha com seu usuário do Docker Hub e senhas reais.

# Usuário do Docker Hub (imagem SEU_USUARIO/gestao:latest)
DOCKERHUB_USER=seu_usuario_dockerhub

# Banco (mesmo valor usado pelo Postgres e pela app)
POSTGRES_DB=gestaodb
POSTGRES_USER=gestao
POSTGRES_PASSWORD=defina_uma_senha_forte
